# ============================================================
#  School HelpDesk — переменные окружения production-сервера
#  Скопируйте в /etc/school-helpdesk.env и ОБЯЗАТЕЛЬНО поменяйте пароли!
#    sudo cp deploy/helpdesk.env.example /etc/school-helpdesk.env
#    sudo chmod 600 /etc/school-helpdesk.env
# ============================================================

# --- веб-порт (80 — стандартный HTTP; за nginx с HTTPS используйте 8080) ---
SERVER_PORT=80

# --- PostgreSQL (docker compose из корня проекта) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk
DB_USER=helpdesk
DB_PASSWORD=ЗАМЕНИТЕ-НА-СВОЙ-ПАРОЛЬ

# --- безопасность: секрет подписи JWT, минимум 32 символа ---
# сгенерировать: openssl rand -base64 48
APP_JWT_SECRET=ЗАМЕНИТЕ-НА-СЛУЧАЙНУЮ-СТРОКУ-МИНИМУМ-32-СИМВОЛА
APP_JWT_EXPIRATION=12h

# --- первичный администратор (создаётся при первом старте, затем смените пароль в системе) ---
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=ЗАМЕНИТЕ-ПЕРЕД-ПЕРВЫМ-ЗАПУСКОМ

# --- демонстрационные данные: в production должно быть false ---
APP_SEED_ENABLED=true
APP_SEED_DEMO=false

# --- Swagger UI отключён в production ---
SPRINGDOC_ENABLED=false
