# ============================================================
#  School HelpDesk — systemd-юнит
#  Установка:
#    sudo cp deploy/school-helpdesk.service /etc/systemd/system/
#    sudo cp deploy/helpdesk.env.example /etc/school-helpdesk.env  # отредактируйте!
#    sudo chmod 600 /etc/school-helpdesk.env
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now school-helpdesk
#  Статус/логи:
#    systemctl status school-helpdesk
#    journalctl -u school-helpdesk -f
# ============================================================
[Unit]
Description=School HelpDesk — система управления техническими заявками
Documentation=file:/opt/school-helpdesk/README.md
After=network-online.target docker.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
# отдельный непривилегированный пользователь (создать: sudo useradd -r -s /usr/sbin/nologin helpdesk)
User=helpdesk
Group=helpdesk

# каталог с приложением: положите туда school-helpdesk.jar
WorkingDirectory=/opt/school-helpdesk
EnvironmentFile=/etc/school-helpdesk.env

ExecStart=/usr/bin/java -Xms128m -Xmx512m -jar /opt/school-helpdesk/school-helpdesk.jar

Restart=on-failure
RestartSec=5
SuccessExitStatus=143

# порт 80 требует прав root: разрешаем связывать порты <1024 без root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# базовое усиление
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/school-helpdesk/logs

# лимит логов через journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=school-helpdesk

[Install]
WantedBy=multi-user.target
